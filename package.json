{
  "private": true,
  "name": "ahmad-mujtaba-portfolio",
  "version": "2.4.0",
  "homepage": "https://pypi-ahmad.github.io",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').copyFileSync('build/index.html','build/404.html')\"",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "framer-motion": "^13.1.0",
    "react": "^19.2.8",
    "react-animated-cursor": "^2.11.2",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "react-ga4": "^3.0.1",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "styled-components": "^6.5.2",
    "web-vitals": "^6.1.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@vitejs/plugin-react": "6.0.5",
    "ajv": "^8.20.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "react-animated-cursor": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
