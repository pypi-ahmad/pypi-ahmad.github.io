{
  "private": true,
  "name": "ahmad-mujtaba-portfolio",
  "version": "2.4.0",
  "homepage": "https://pypi-ahmad.github.io",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build && node -e \"const fs=require('fs');fs.copyFileSync('build/index.html','build/404.html');for(const route of ['home','experience','education','contact','splash','projects','skills']){fs.mkdirSync('build/'+route,{recursive:true});fs.copyFileSync('build/index.html','build/'+route+'/index.html')}\"",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "dependencies": {
    "framer-motion": "^13.2.0",
    "react": "^19.3.0",
    "react-animated-cursor": "^2.11.2",
    "react-dom": "^19.3.0",
    "react-ga4": "^3.0.1",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.3",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "react-animated-cursor": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
